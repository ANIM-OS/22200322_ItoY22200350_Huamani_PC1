rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function drawIsOpen(drawId) {
      return get(/databases/$(database)/documents/sorteos/$(drawId)).data.estado == 'abierto';
    }

    function validNumbers(numbers) {
      return numbers is list
        && numbers.size() == 6
        && numbers.toSet().size() == 6
        && numbers[0] is int && numbers[0] >= 1 && numbers[0] <= 45
        && numbers[1] is int && numbers[1] >= 1 && numbers[1] <= 45
        && numbers[2] is int && numbers[2] >= 1 && numbers[2] <= 45
        && numbers[3] is int && numbers[3] >= 1 && numbers[3] <= 45
        && numbers[4] is int && numbers[4] >= 1 && numbers[4] <= 45
        && numbers[5] is int && numbers[5] >= 1 && numbers[5] <= 45;
    }

    match /sorteos/{drawId} {
      allow read: if signedIn();
      allow write: if false;

      match /bolillas/{ballId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /jugadas/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && drawIsOpen(drawId)
          && request.resource.data.keys().hasAll(['sorteoId', 'uid', 'numeros', 'fechaRegistro'])
          && request.resource.data.keys().hasOnly(['sorteoId', 'uid', 'numeros', 'fechaRegistro'])
          && request.resource.data.sorteoId == drawId
          && request.resource.data.uid == uid
          && request.resource.data.fechaRegistro is timestamp
          && validNumbers(request.resource.data.numeros);
        allow update, delete: if false;
      }
    }
  }
}
